rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in @moe.edu.sg accounts may access anything in this
    // database. This mirrors the same domain check the app does after
    // Google Sign-In — enforcing it here too means a client-side bug (or
    // someone bypassing the app's own check) still can't get in with a
    // non-school account, since Firestore itself is the actual gatekeeper.
    function isMoeUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@moe[.]edu[.]sg$');
    }

    // Discipline log entries. Deletion is permanent and immediate (no
    // soft-delete/recovery step) — a signed-in teacher can remove any
    // entry directly.
    match /incidents/{incidentId} {
      allow read, create, update, delete: if isMoeUser();
    }

    // ISS / OSS suspension records — same protection.
    match /suspensions/{suspensionId} {
      allow read, create, update, delete: if isMoeUser();
    }

    // Parent meeting logs — same protection.
    match /parentMeetings/{meetingId} {
      allow read, create, update, delete: if isMoeUser();
    }

    // Rolling backup snapshot ("backups/latest"). Signed-in users can read it
    // (to manually recover data) and the app can update it, but it can never
    // be deleted from the client.
    match /backups/{backupId} {
      allow read, create, update: if isMoeUser();
      allow delete: if false;
    }
    // Shared Singapore holiday calendar (public holidays + school holiday
    // blocks) used to auto-schedule multi-day suspensions. Any signed-in
    // teacher can read/update it — there's nothing sensitive here, and it
    // needs to be editable each year when MOE/MOM publish new dates.
    match /holidays/{docId} {
      allow read, write: if isMoeUser();
    }

    match /settings/{docId} {
      allow read, write: if isMoeUser();
    }

    // One doc per signed-in teacher, holding their chosen display name
    // and confirmed school email — read by everyone (for the User List
    // page), but each person can only ever write their own doc.
    match /users/{uid} {
      allow read: if isMoeUser();
      allow create, update: if isMoeUser() && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
